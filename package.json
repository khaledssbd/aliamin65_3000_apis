  "description": "Clean Swift is a premium, full-stack laundry and dry-cleaning service platform built with a focus on efficiency and modern user experience. Leveraging the power of Next.js and TypeScript, the application offers a seamless interface for users to schedule pickups, track orders in real-time, and manage laundry preferences. Styled with Tailwind CSS and backed by a robust Node.js/Express backend with MongoDB, Clean Swift ensures a secure, fast, and scalable solution for urban laundry management.",
  "keywords": [
    "laundry-service",
    "dry-cleaning",
    "on-demand-laundry",
    "clean-swift",
    "nextjs-ecommerce",
    "typescript",
    "tailwind-css",
    "nodejs",
    "expressjs",
    "mongodb-mongoose",
    "order-tracking",
    "service-booking-app",
    "fullstack-javascript"
  ],
  "license": "ISC",
  "main": "server.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparktechagency/aliamin65_apis_backend.git"
  },
  "bugs": {
    "url": "https://github.com/sparktechagency/aliamin65_apis_backend/issues"
  },
  "homepage": "https://github.com/sparktechagency/aliamin65_apis_backend#readme",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only --poll src/server.ts",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:all": "prettier --write .",
    "generate": "node generate",
    "create-module": "npx ts-node src/scripts/createModule.ts",
    "deploy": "pnpm build && vercel && vercel --prod"
  },
